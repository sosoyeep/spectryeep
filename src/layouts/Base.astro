---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Analytics from '../components/Analytics.astro';
import { LOCALE_META, type Locale, LOCALES, DEFAULT_LOCALE } from '../consts';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path WITHOUT locale prefix, e.g. "/" or "/products/innovate-t5/" */
  path: string;
  schemaType?: 'website' | 'product' | 'article';
  product?: any;
  article?: any;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faq?: Array<{ q: string; a: string }>;
  whatsappContext?: 'general' | 'product' | 'learn';
  productName?: string;
  alternateLocales?: Locale[];
  robots?: string;
}

const {
  locale,
  title,
  description,
  path,
  schemaType = 'website',
  product,
  article,
  breadcrumbs,
  faq,
  whatsappContext = 'general',
  productName,
  alternateLocales = LOCALES,
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
} = Astro.props;

const meta = LOCALE_META[locale];
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const alternateLinks = alternateLocales.map((l) => ({
  hreflang: LOCALE_META[l].htmlLang,
  href: new URL(localizedPath(l, path), Astro.site).toString(),
}));
const xDefault = new URL(localizedPath(DEFAULT_LOCALE, path), Astro.site).toString();

/**
 * Build an SEO-optimal meta description (target 110-160 chars, hard cap 160).
 * Strategy:
 *   1. If the raw description already <= 160, use it as-is.
 *   2. Try the first sentence (split on . ! ? 。 ؟); use it if it lands in 60-160.
 *   3. Otherwise trim at 155 chars to the last sentence-end punctuation if any,
 *      else last comma/semicolon (, ; ， ；), else last whitespace.
 *   4. Append … if truncated.
 *
 * Applied only to <meta name="description"> / og:description / twitter:description.
 * Schema.org and page body keep using the original long-form text.
 */
function trimToMetaLength(raw: string): string {
  const TARGET_MAX = 160;
  const TARGET_MIN = 60;
  const HARD_CUT = 158;
  // Soft cap when keeping a whole first sentence — Google truncates at ~160 desktop,
  // 120 mobile, but social platforms (FB/LinkedIn) display 200+. Prefer a clean
  // sentence ending up to 175 chars over a mid-sentence ellipsis at 155.
  const FIRST_SENT_SOFT_CAP = 175;
  const s = (raw || '').trim();
  if (s.length <= TARGET_MAX) return s;

  // Step 1: first sentence (handles Latin . ! ? plus Chinese 。 and Arabic ؟)
  const sentMatch = s.match(/^([^.!?。؟]+[.!?。؟])/);
  if (sentMatch) {
    const first = sentMatch[1].trim();
    if (first.length >= TARGET_MIN && first.length <= FIRST_SENT_SOFT_CAP) return first;
  }

  // Step 2: trim at HARD_CUT, prefer last punctuation/space boundary
  const cut = s.slice(0, HARD_CUT);
  const punctIdx = Math.max(
    cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '),
    cut.lastIndexOf('; '), cut.lastIndexOf(', '),
    cut.lastIndexOf('，'), cut.lastIndexOf('；'), cut.lastIndexOf('، '),
  );
  if (punctIdx > TARGET_MIN) {
    // include the punctuation char itself, drop the trailing space
    return cut.slice(0, punctIdx + 1).trim() + '…';
  }
  const spaceIdx = cut.lastIndexOf(' ');
  if (spaceIdx > TARGET_MIN) {
    return cut.slice(0, spaceIdx).trim() + '…';
  }
  return cut.trim() + '…';
}

const metaDescription = trimToMetaLength(description);

/**
 * Trim <title> to <=80 chars (target <=60). Google truncates at ~60 desktop,
 * 50-60 mobile. Strategy:
 *   1. If <=60, keep as-is.
 *   2. If ends with " | JIEBO Instrument" (20 chars) and stripping the suffix
 *      lands <=80, drop the suffix — Google appends the site name automatically
 *      and we keep the keyword-rich part.
 *   3. If still >80, try splitting at " — " / " – " / " - " and use the lead
 *      clause + short " | JIEBO" suffix (24 chars).
 *   4. Hard fallback: trim to 70 at word boundary + …
 *
 * Applied to BOTH <title> AND og:title / twitter:title — Facebook truncates
 * at ~60-65 chars on mobile, LinkedIn at ~70, so a single trim keeps SEO and
 * social cards consistent and gets rid of opengraph.xyz "title too long"
 * warnings.
 */
function trimTitleForGoogle(t: string): string {
  const BRAND_SUFFIX = ' | JIEBO Instrument';
  const SHORT_SUFFIX = ' | JIEBO';
  const SOFT_MAX = 80;
  const TARGET = 60;
  const HARD_CUT = 70;
  const s = (t || '').trim();
  if (s.length <= TARGET) return s;
  if (s.endsWith(BRAND_SUFFIX)) {
    const stripped = s.slice(0, -BRAND_SUFFIX.length).trim();
    if (stripped.length <= SOFT_MAX) return stripped;
    // Try split at em-dash variants
    for (const sep of [' — ', ' – ', ' - ']) {
      const idx = stripped.indexOf(sep);
      if (idx > 0) {
        const lead = stripped.slice(0, idx).trim();
        if (lead.length >= 20 && lead.length + SHORT_SUFFIX.length <= SOFT_MAX) {
          return lead + SHORT_SUFFIX;
        }
      }
    }
    // Hard trim
    const cut = stripped.slice(0, HARD_CUT);
    const sp = cut.lastIndexOf(' ');
    if (sp > 30) return cut.slice(0, sp).trim() + '…';
    return cut + '…';
  }
  // No standard suffix
  const cut = s.slice(0, HARD_CUT);
  const sp = cut.lastIndexOf(' ');
  if (sp > 30) return cut.slice(0, sp).trim() + '…';
  return cut + '…';
}

const pageTitle = trimTitleForGoogle(title);
---
<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  {alternateLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
  <link rel="alternate" hreflang="x-default" href={xDefault} />
  <meta property="og:type" content={schemaType === 'article' ? 'article' : 'website'} />
  <meta property="og:locale" content={meta.htmlLang} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="JIEBO Instrument" />
  <meta property="og:image" content={new URL('/og/default.png', Astro.site).toString()} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="JIEBO Instrument — Optical Emission Spectrometer Manufacturer, Wuxi China" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={new URL('/og/default.png', Astro.site).toString()} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <Analytics />
  <SchemaOrg
    type={schemaType}
    pageUrl={canonical}
    product={product}
    article={article}
    breadcrumbs={breadcrumbs}
    faq={faq}
  />
</head>
<body>
  <Header locale={locale} pathWithoutLocale={path} alternateLocales={alternateLocales} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} />
  <WhatsAppFab locale={locale} context={whatsappContext} productName={productName} />
</body>
</html>
