---
import SeoLandingPage from '../../../components/SeoLandingPage.astro';
import { LANDING_PAGES, localizedLandingPage } from '../../../data/landing-pages';

export function getStaticPaths() {
  return LANDING_PAGES.filter((p) => p.kind === 'countries').map((page) => ({
    params: { slug: page.slug },
    props: { page: localizedLandingPage(page, 'ru') },
  }));
}

const { page } = Astro.props;
---
<SeoLandingPage locale="ru" page={page} />
