---
import ProductPage from '../../components/ProductPage.astro';
import { PRODUCT_LIST } from '../../data/products/_registry';

export function getStaticPaths() {
  return PRODUCT_LIST.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---
<ProductPage locale="en" slug={slug!} />
