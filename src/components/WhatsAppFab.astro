---
import { SITE } from '../consts';
import { whatsappUrl, t } from '../i18n/utils';
import type { Locale } from '../consts';
import type { UIKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  context?: 'general' | 'product' | 'learn';
  productName?: string;
}

const { locale, context = 'general', productName } = Astro.props;
const key: UIKey =
  context === 'product' ? 'whatsapp.prefill_product' : context === 'learn' ? 'whatsapp.prefill_learn' : 'whatsapp.prefill_general';
const text = t(locale, key, productName ? { product: productName } : undefined);
const href = whatsappUrl(SITE.whatsapp, text);
const label = t(locale, 'cta.whatsapp_fab');
---
<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t(locale, 'cta.whatsapp')}
  data-wa-context={context}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A12 12 0 0 0 3.48 20.52L2 22l1.49-1.48A12 12 0 1 0 20.52 3.48zm-8.52 17a8.49 8.49 0 0 1-4.34-1.18l-.31-.18-3.69.97.98-3.6-.2-.32A8.5 8.5 0 1 1 12 20.48zm4.66-6.36c-.25-.13-1.5-.74-1.73-.83-.23-.08-.4-.13-.57.13-.17.25-.65.83-.8 1-.15.17-.3.19-.55.06-.25-.13-1.06-.39-2.02-1.25-.75-.66-1.25-1.48-1.4-1.73-.15-.25-.02-.39.11-.51.11-.11.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.57-1.38-.78-1.89-.21-.5-.42-.43-.57-.43h-.49c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.43 1.03 2.6.13.17 1.78 2.71 4.31 3.8.6.26 1.07.42 1.43.54.6.19 1.15.16 1.58.1.48-.07 1.5-.61 1.71-1.2.21-.59.21-1.09.15-1.2-.06-.11-.23-.17-.48-.3z"/>
  </svg>
  <span>{label}</span>
</a>
