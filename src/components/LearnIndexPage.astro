---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { LEARN_ARTICLES } from '../data/learn-articles';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/learn/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_general'));

const copy: Record<Locale, {
  title: string; lede: string;
  articles: Array<{ slug: string; title: string; summary: string }>;
}> = {
  en: {
    title: 'JIEBO Knowledge Base',
    lede: 'Practical guides to optical emission spectrometry, X-ray fluorescence, laser-induced breakdown spectroscopy and combustion-based elemental analysis. Written by JIEBO application engineers for foundry, metallurgy, aerospace and recycling customers.',
    articles: LEARN_ARTICLES.en,
  },
  ru: {
    title: 'База знаний JIEBO',
    lede: 'Практические руководства по оптико-эмиссионной спектрометрии, рентгенофлуоресцентному анализу, лазерно-индуцированной плазменной спектроскопии и элементному анализу методом сжигания. Написаны прикладными инженерами JIEBO для литейных, металлургических, аэрокосмических и перерабатывающих заказчиков.',
    articles: LEARN_ARTICLES.ru,
  },
  es: {
    title: 'Base de conocimientos JIEBO',
    lede: 'Guías prácticas sobre espectrometría de emisión óptica, fluorescencia de rayos X, espectroscopia LIBS y análisis elemental por combustión. Escritas por los ingenieros de aplicación de JIEBO para clientes de fundición, metalurgia, aeroespacial y reciclaje.',
    articles: LEARN_ARTICLES.es,
  },
  ar: {
    title: 'قاعدة معرفة JIEBO',
    lede: 'أدلّة عملية حول مطيافيّة الانبعاث الضوئي وفلوريسنت الأشعة السينية وطيف الانهيار بالليزر (LIBS) وتحليل العناصر بالاحتراق. كتبها مهندسو التطبيق في JIEBO لعملاء المسابك والمعادن والطيران وإعادة التدوير.',
    articles: LEARN_ARTICLES.ar,
  },
};

const c = copy[locale];
const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.learn'), url: canonical },
];
---
<Base
  locale={locale}
  title={`${c.title} | JIEBO Instrument`}
  description={c.lede}
  path={path}
  schemaType="website"
  breadcrumbs={breadcrumbs}
  whatsappContext="learn"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <span>{t(locale, 'breadcrumb.learn')}</span>
    </nav>
  </div>

  <section class="section" style="padding-block-start:1rem;">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">{t(locale, 'breadcrumb.learn')}</p>
      <h1>{c.title}</h1>
      <p class="lede" style="margin-top:1rem;">{c.lede}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="max-width:820px;">
      <div class="grid" style="gap:1rem;">
        {c.articles.map((a) => (
          <a class="card" href={localizedPath(locale, `/learn/${a.slug}/`)} style="padding:1.5rem;">
            <h3 style="margin-bottom:0.5rem;">{a.title}</h3>
            <p style="margin:0; color:var(--muted);">{a.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <div class="card" style="background:var(--card);">
        <p style="margin-bottom:1rem; color:var(--muted);">
          {locale === 'en' && 'Have a specific application question not covered here? Ask our engineers directly.'}
          {locale === 'ru' && 'Есть конкретный вопрос по применению, не покрытый здесь? Спросите наших инженеров напрямую.'}
          {locale === 'es' && '¿Tiene una pregunta de aplicación específica no cubierta aquí? Pregunte directamente a nuestros ingenieros.'}
          {locale === 'ar' && 'هل لديك سؤال تطبيقي محدّد لا تجد إجابته هنا؟ اسأل مهندسينا مباشرةً.'}
        </p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')}</a>
      </div>
    </div>
  </section>
</Base>
