---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { title, description, datePublished, sections, faq, compareTable } from '../data/learn-oes-vs-xrf-vs-libs';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/learn/oes-vs-xrf-vs-libs/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_learn'));
const pageTitle = `${title[locale]} | JIEBO Instrument`;

const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.learn'), url: new URL(localizedPath(locale, '/learn/'), Astro.site).toString() },
  { name: title[locale], url: canonical },
];

const articleSchema = {
  headline: title[locale],
  description: description[locale],
  datePublished,
};

const table = compareTable[locale];
---
<Base
  locale={locale}
  title={pageTitle}
  description={description[locale]}
  path={path}
  schemaType="article"
  article={articleSchema}
  breadcrumbs={breadcrumbs}
  faq={faq[locale]}
  whatsappContext="learn"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <a href={localizedPath(locale, '/learn/')}>{t(locale, 'breadcrumb.learn')}</a> /
      <span>{title[locale]}</span>
    </nav>
  </div>

  <article class="section" style="padding-block-start:1rem;">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">{t(locale, 'breadcrumb.learn')}</p>
      <h1>{title[locale]}</h1>
      <p class="lede" style="margin-top:1rem;">{description[locale]}</p>

      {sections[locale].map((s, idx) => (
        <section style="margin-top:2rem;">
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p set:html={p.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')} />)}
          {idx === 1 && (
            <div style="overflow-x:auto; margin-top:1rem;">
              <table class="spec" style="min-width:680px;">
                <caption style="caption-side:bottom; text-align:start; color:var(--muted); font-size:0.9rem; padding-top:0.5rem;">{table.caption}</caption>
                <thead>
                  <tr>{table.cols.map((c) => <th>{c}</th>)}</tr>
                </thead>
                <tbody>
                  {table.rows.map((row) => (
                    <tr>
                      <th scope="row">{row[0]}</th>
                      {row.slice(1).map((cell) => <td>{cell}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      <section style="margin-top:2.5rem;">
        <h2>{t(locale, 'product.faq_title')}</h2>
        {faq[locale].map((f) => (
          <details class="faq" style="margin-top:0.5rem;">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </section>

      <aside class="card" style="margin-top:2.5rem; background:var(--card);">
        <h3 style="margin-bottom:0.5rem;">{t(locale, 'cta.inquiry')}</h3>
        <p style="margin-bottom:1rem; color:var(--muted);">
          {locale === 'en' && 'Need help selecting between OES, XRF and LIBS for your specific application? Send us your sample type and target elements on WhatsApp — engineers reply within 4 working hours.'}
          {locale === 'ru' && 'Нужна помощь в выборе между ОЭС, РФА и LIBS под вашу задачу? Напишите тип образца и нужные элементы в WhatsApp — инженеры отвечают за 4 рабочих часа.'}
          {locale === 'es' && '¿Necesita ayuda para elegir entre OES, XRF y LIBS para su aplicación? Envíenos el tipo de muestra y los elementos objetivo por WhatsApp — los ingenieros responden en 4 horas hábiles.'}
          {locale === 'ar' && 'هل تحتاج مساعدة في الاختيار بين OES و XRF و LIBS لتطبيقك؟ أرسل لنا نوع العيّنة والعناصر المستهدفة عبر واتساب — يردّ المهندسون خلال 4 ساعات عمل.'}
        </p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')}</a>
      </aside>
    </div>
  </article>
</Base>
