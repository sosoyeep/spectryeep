---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/contact/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_general'));

const copy: Record<Locale, {
  title: string; lede: string;
  primaryTitle: string; primaryBody: string;
  channelsTitle: string;
  labels: { whatsapp: string; email: string; phone: string; phoneAlt: string; wechat: string; skype: string };
  rfqTitle: string; rfqBody: string; rfqSubmit: string;
  form: { name: string; company: string; country: string; email: string; phone: string; material: string; elements: string; volume: string; message: string };
  addressesTitle: string;
  headOfficeLabel: string; factoryLabel: string;
  hoursTitle: string; hoursBody: string;
}> = {
  en: {
    title: 'Contact JIEBO Instrument',
    lede: 'Reach our spectrometer engineers directly. We answer most WhatsApp inquiries within 4 working hours (Beijing time, Mon–Sat).',
    primaryTitle: 'Fastest reply — WhatsApp',
    primaryBody: 'Pre-fill a message in your language and our engineers reply with a quote, lead time and recommended model.',
    channelsTitle: 'All contact channels',
    labels: { whatsapp: 'WhatsApp', email: 'Email', phone: 'Phone (main)', phoneAlt: 'Phone (alt)', wechat: 'WeChat', skype: 'Skype' },
    rfqTitle: 'Request a quote by email',
    rfqBody: 'Send the key buying details once, so our engineers can recommend the right instrument and reply with price, lead time and configuration.',
    rfqSubmit: 'Open email RFQ',
    form: {
      name: 'Name',
      company: 'Company',
      country: 'Country',
      email: 'Email',
      phone: 'WhatsApp / phone',
      material: 'Sample material or alloy matrix',
      elements: 'Target elements',
      volume: 'Monthly sample volume',
      message: 'Application notes',
    },
    addressesTitle: 'Visit us',
    headOfficeLabel: 'Head office',
    factoryLabel: 'Manufacturing facility',
    hoursTitle: 'Office hours',
    hoursBody: 'Monday – Saturday, 09:00 – 18:00 China Standard Time (UTC+8). WhatsApp is monitored outside hours; expect a reply on the next working day.',
  },
  ru: {
    title: 'Свяжитесь с JIEBO Instrument',
    lede: 'Пишите напрямую инженерам по спектрометрам. Большинство запросов в WhatsApp обрабатываются за 4 рабочих часа (пекинское время, пн–сб).',
    primaryTitle: 'Самый быстрый ответ — WhatsApp',
    primaryBody: 'Сообщение предзаполнено на вашем языке; инженеры отвечают ценой, сроком поставки и рекомендованной моделью.',
    channelsTitle: 'Все каналы связи',
    labels: { whatsapp: 'WhatsApp', email: 'Эл. почта', phone: 'Телефон (основной)', phoneAlt: 'Телефон (доп.)', wechat: 'WeChat', skype: 'Skype' },
    rfqTitle: 'Запросить предложение по email',
    rfqBody: 'Отправьте основные данные о задаче, чтобы инженеры подобрали модель и ответили по цене, сроку и конфигурации.',
    rfqSubmit: 'Открыть email-запрос',
    form: {
      name: 'Имя',
      company: 'Компания',
      country: 'Страна',
      email: 'Email',
      phone: 'WhatsApp / телефон',
      material: 'Материал или матрица сплава',
      elements: 'Целевые элементы',
      volume: 'Объем образцов в месяц',
      message: 'Примечания по применению',
    },
    addressesTitle: 'Адреса',
    headOfficeLabel: 'Головной офис',
    factoryLabel: 'Производство',
    hoursTitle: 'Часы работы',
    hoursBody: 'Понедельник – суббота, 09:00 – 18:00 по китайскому стандартному времени (UTC+8). WhatsApp мониторится и вне часов — ответ на следующий рабочий день.',
  },
  es: {
    title: 'Contactar a JIEBO Instrument',
    lede: 'Hable directamente con nuestros ingenieros de espectrómetros. Respondemos la mayoría de los WhatsApp en 4 horas hábiles (hora de Pekín, lun–sáb).',
    primaryTitle: 'Respuesta más rápida — WhatsApp',
    primaryBody: 'Mensaje pre-llenado en su idioma; los ingenieros responden con cotización, plazo y modelo recomendado.',
    channelsTitle: 'Todos los canales de contacto',
    labels: { whatsapp: 'WhatsApp', email: 'Correo', phone: 'Teléfono (principal)', phoneAlt: 'Teléfono (alterno)', wechat: 'WeChat', skype: 'Skype' },
    rfqTitle: 'Solicitar cotización por correo',
    rfqBody: 'Envíe los datos clave de compra para que nuestros ingenieros recomienden el instrumento correcto y respondan con precio, plazo y configuración.',
    rfqSubmit: 'Abrir RFQ por correo',
    form: {
      name: 'Nombre',
      company: 'Empresa',
      country: 'País',
      email: 'Correo',
      phone: 'WhatsApp / teléfono',
      material: 'Material o matriz de aleación',
      elements: 'Elementos objetivo',
      volume: 'Volumen mensual de muestras',
      message: 'Notas de aplicación',
    },
    addressesTitle: 'Visítenos',
    headOfficeLabel: 'Oficina central',
    factoryLabel: 'Planta de fabricación',
    hoursTitle: 'Horario',
    hoursBody: 'Lunes a sábado, 09:00 – 18:00 hora estándar de China (UTC+8). WhatsApp se monitorea fuera de horario; respuesta el siguiente día hábil.',
  },
  ar: {
    title: 'تواصل مع JIEBO Instrument',
    lede: 'تواصل مباشرةً مع مهندسي أجهزة الطيف لدينا. نردّ على معظم استفسارات واتساب خلال 4 ساعات عمل (بتوقيت بكين، الإثنين إلى السبت).',
    primaryTitle: 'أسرع ردّ — واتساب',
    primaryBody: 'الرسالة معبّأة مسبقاً بلغتك، ويردّ المهندسون بعرض سعر ومدّة تسليم وموديل موصى به.',
    channelsTitle: 'كل قنوات التواصل',
    labels: { whatsapp: 'واتساب', email: 'البريد الإلكتروني', phone: 'الهاتف (رئيسي)', phoneAlt: 'الهاتف (بديل)', wechat: 'WeChat', skype: 'Skype' },
    rfqTitle: 'اطلب عرض سعر عبر البريد',
    rfqBody: 'أرسل تفاصيل الشراء الأساسية ليقترح المهندسون الجهاز المناسب ويردّوا بالسعر ومدة التسليم والتكوين.',
    rfqSubmit: 'فتح طلب عبر البريد',
    form: {
      name: 'الاسم',
      company: 'الشركة',
      country: 'الدولة',
      email: 'البريد الإلكتروني',
      phone: 'واتساب / هاتف',
      material: 'مادة العينة أو مصفوفة السبيكة',
      elements: 'العناصر المطلوبة',
      volume: 'عدد العينات شهرياً',
      message: 'ملاحظات التطبيق',
    },
    addressesTitle: 'تفضّل بزيارتنا',
    headOfficeLabel: 'المكتب الرئيسي',
    factoryLabel: 'منشأة التصنيع',
    hoursTitle: 'ساعات العمل',
    hoursBody: 'الإثنين إلى السبت، من 09:00 إلى 18:00 بتوقيت الصين القياسي (UTC+8). يُرصد واتساب خارج هذه الساعات والردّ في يوم العمل التالي.',
  },
};

const c = copy[locale];
const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'nav.contact'), url: canonical },
];
---
<Base
  locale={locale}
  title={`${c.title} | JIEBO Instrument`}
  description={c.lede}
  path={path}
  schemaType="website"
  breadcrumbs={breadcrumbs}
  whatsappContext="general"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <span>{t(locale, 'nav.contact')}</span>
    </nav>
  </div>

  <section class="section" style="padding-block-start:1rem;">
    <div class="container" style="max-width:780px;">
      <p class="eyebrow">JIEBO Instrument · Wuxi, China</p>
      <h1>{c.title}</h1>
      <p class="lede" style="margin-top:1rem;">{c.lede}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="max-width:780px;">
      <div class="card" style="text-align:center; background:var(--bg);">
        <h2 style="margin-bottom:0.5rem;">{c.primaryTitle}</h2>
        <p style="color:var(--muted); margin-bottom:1rem;">{c.primaryBody}</p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener" style="font-size:1.125rem; padding:1rem 1.75rem;">
          {t(locale, 'cta.whatsapp')} · {SITE.wechat}
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2>{c.channelsTitle}</h2>
      <dl class="facts" style="grid-template-columns: max-content 1fr; margin-top:1rem;">
        <dt>{c.labels.whatsapp}</dt><dd><a href={waHref} target="_blank" rel="noopener">{SITE.wechat}</a></dd>
        <dt>{c.labels.email}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        <dt>{c.labels.phone}</dt><dd>{SITE.phone}</dd>
        <dt>{c.labels.phoneAlt}</dt><dd>{SITE.phoneAlt}</dd>
        <dt>{c.labels.wechat}</dt><dd>{SITE.wechat}</dd>
        <dt>{c.labels.skype}</dt><dd>{SITE.skype}</dd>
      </dl>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="max-width:780px;">
      <div class="card" style="background:var(--bg);">
        <h2>{c.rfqTitle}</h2>
        <p style="color:var(--muted); margin-top:0.5rem;">{c.rfqBody}</p>
        <form action={`mailto:${SITE.email}`} method="post" enctype="text/plain" style="display:grid; gap:1rem; margin-top:1.25rem;">
          <div class="grid" style="grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
            <label>{c.form.name}<input name="Name" autocomplete="name" /></label>
            <label>{c.form.company}<input name="Company" autocomplete="organization" /></label>
            <label>{c.form.country}<input name="Country" autocomplete="country-name" /></label>
            <label>{c.form.email}<input name="Email" type="email" autocomplete="email" /></label>
            <label>{c.form.phone}<input name="WhatsApp or phone" autocomplete="tel" /></label>
            <label>{c.form.volume}<input name="Monthly sample volume" /></label>
          </div>
          <label>{c.form.material}<input name="Sample material or alloy matrix" /></label>
          <label>{c.form.elements}<input name="Target elements" /></label>
          <label>{c.form.message}<textarea name="Application notes" rows="5"></textarea></label>
          <button class="button button--primary" type="submit" style="justify-self:start;">{c.rfqSubmit}</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="max-width:780px;">
      <h2>{c.addressesTitle}</h2>
      <dl class="facts" style="grid-template-columns: max-content 1fr; margin-top:1rem;">
        <dt>{c.headOfficeLabel}</dt><dd>{SITE.headOffice}</dd>
        <dt>{c.factoryLabel}</dt><dd>{SITE.factory}</dd>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2>{c.hoursTitle}</h2>
      <p>{c.hoursBody}</p>
    </div>
  </section>
</Base>
