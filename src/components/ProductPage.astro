---
import Base from '../layouts/Base.astro';
import ProductImage from './ProductImage.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { getProduct } from '../data/products/_registry';
import { specLabels } from '../data/products/_specLabels';
import { COMPARE_LIST } from '../data/compares/_registry';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;

const product = getProduct(slug);
if (!product) {
  throw new Error(`Unknown product slug: ${slug}`);
}

const path = `/products/${slug}/`;
const title = `${product.name} | JIEBO Instrument`;
const description = product.overview[locale];
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_product', { product: product.name }));

const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.products'), url: new URL(localizedPath(locale, '/products/'), Astro.site).toString() },
  { name: product.name, url: canonical },
];

const productSchema = {
  name: product.name,
  description: product.overview[locale],
  sku: product.sku,
  category: product.category === 'oes' ? 'Optical Emission Spectrometer' : product.category === 'elemental' ? 'Elemental Analyzer' : 'Handheld Analyzer',
  image: product.image ? new URL(product.image, Astro.site).toString() : undefined,
};

function resolveLabel(labelKey: string): string {
  return specLabels[labelKey]?.[locale] ?? labelKey;
}

const relatedCompares = COMPARE_LIST.filter(
  (c) => c.sideA.productSlug === slug || c.sideB.productSlug === slug,
).map((c) => ({
  slug: c.slug,
  matchup: `${c.sideA.name} vs ${c.sideB.name}`,
  title: c.title[locale],
  description: c.description[locale],
}));
---
<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  schemaType="product"
  product={productSchema}
  breadcrumbs={breadcrumbs}
  faq={product.faq[locale]}
  whatsappContext="product"
  productName={product.name}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <a href={localizedPath(locale, '/products/')}>{t(locale, 'breadcrumb.products')}</a> /
      <span>{product.name}</span>
    </nav>
  </div>

  <section class="section" style="padding-block-start:1rem;">
    <div class="container product-hero">
      <div class="product-hero__copy">
        <p class="eyebrow">JIEBO Instrument · {product.sku}</p>
        <h1>{product.name}</h1>
        <p class="lede" style="margin-top:1rem;">{product.overview[locale]}</p>
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
          <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
            {t(locale, 'cta.inquiry')}
          </a>
          <a class="button button--ghost" href={localizedPath(locale, '/products/')}>
            {t(locale, 'breadcrumb.products')}
          </a>
        </div>
      </div>
      <div class="product-hero__media">
        <ProductImage product={product} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'product.spec_title')}</h2>
      <table class="spec" style="margin-top:1rem;">
        <tbody>
          {product.specs.map((row) => (
            <tr>
              <th scope="row">{resolveLabel(row.labelKey)}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t(locale, 'product.applications_title')}</h2>
      <ul style="margin-top:1rem; padding-inline-start:1.25rem;">
        {product.applications[locale].map((line) => <li style="margin-bottom:0.5rem;">{line}</li>)}
      </ul>
    </div>
  </section>

  {relatedCompares.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{t(locale, 'compare.related_title')}</h2>
        <div class="grid" style="gap:1rem; margin-top:1rem;">
          {relatedCompares.map((rc) => (
            <a class="card" href={localizedPath(locale, `/compare/${rc.slug}/`)} style="padding:1.25rem;">
              <p class="eyebrow" style="margin:0 0 0.35rem;">{rc.matchup}</p>
              <h3 style="margin:0 0 0.4rem; font-size:1.15rem;">{rc.title}</h3>
              <p style="margin:0; color:var(--muted);">{rc.description}</p>
              <p style="margin:0.75rem 0 0;"><span class="button button--ghost" style="pointer-events:none;">{t(locale, 'compare.read')}</span></p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'product.faq_title')}</h2>
      <div style="margin-top:1rem;">
        {product.faq[locale].map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </div>
      <div style="margin-top:2rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
          {t(locale, 'cta.inquiry')} · {SITE.wechat}
        </a>
      </div>
    </div>
  </section>
</Base>
