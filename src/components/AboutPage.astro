  productsTitle: string; productsBody: string;
  workTitle: string; workLede: string; workItems: { h: string; b: string }[];
  exportTitle: string; exportBody: string;
  proofTitle: string; proofBody: string;
  proofLinks: { label: string; href: string }[];
  addressesTitle: string;
