    'cs995': 'محلّل C/S مكتبي بالأشعة تحت الحمراء عالي التردّد، 115 كغ.',
    'cs996': 'محلّل C/S أرضي بخلايا كشف قابلة للتوسعة.',
    'onh-508': 'محلّل أكسجين/نيتروجين/هيدروجين بالانصهار في غاز خامل — للصلب والتيتانيوم والزركونيوم والأتربة النادرة.',
    'f6000-pro': 'محلّل XRF محمول بتقنية Si-PIN، من Ti إلى U، 8 ساعات بطارية، WiFi/Bluetooth.',
    'f7000-pro': 'محلّل LIBS محمول من الفئة 3B، تحليل خلال ثانية، 1.25 كغ — للعناصر الخفيفة.',
  },
};

// localized industries (use UI dict labels where available; for now hard-code)
const industriesLocalized: Record<Locale, string[]> = {
  en: ['Foundry & Casting', 'Metallurgy', 'Steel Mills', 'Aerospace', 'Machinery Manufacturing', 'Scientific Research', 'Nuclear Power', 'Mining & Ore Analysis'],
  ru: ['Литейное производство', 'Металлургия', 'Сталелитейные заводы', 'Аэрокосмическая отрасль', 'Машиностроение', 'Научные исследования', 'Атомная энергетика', 'Горнодобыча и анализ руды'],
  es: ['Fundición y Casting', 'Metalurgia', 'Acerías', 'Aeroespacial', 'Maquinaria', 'Investigación científica', 'Energía nuclear', 'Minería y análisis de mineral'],
  ar: ['السباكة', 'المعادن', 'مصانع الصلب', 'الفضاء', 'صناعة الآلات', 'الأبحاث العلمية', 'الطاقة النووية', 'التعدين وتحليل الخامات'],
};

const path = '/';
---
<Base locale={locale} title={title} description={description} path={path} schemaType="website" whatsappContext="general" faq={FAQ_GENERAL[locale]}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t(locale, 'hero.eyebrow')}</p>
      <h1>{t(locale, 'hero.h1')}</h1>
      <p class="lede">{t(locale, 'hero.lede')}</p>
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
          {t(locale, 'cta.whatsapp')}
        </a>
        <a class="button button--ghost" href={localizedPath(locale, '/products/')}>
          {t(locale, 'cta.explore_products')}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="display:grid; gap:2rem; grid-template-columns: minmax(0,1fr) 320px; align-items:start;">
      <div>
        <h2>{t(locale, 'section.products')}</h2>
        <p class="lede">{t(locale, 'section.products_lede')}</p>
        <div class="grid grid--3" style="margin-top:1.5rem;">
          {PRODUCT_LIST.map((p) => (
            <a class="card product-card" href={localizedPath(locale, `/products/${p.slug}/`)}>
              <ProductImage product={p} locale={locale} variant="thumb" />
              <h3 style="margin-top:0.75rem; margin-bottom:0.4rem; font-size:1.05rem;">{p.name[locale]}</h3>
              <p style="margin:0; color:var(--muted); font-size:0.9rem;">{productShort[locale][p.slug]}</p>
            </a>
          ))}
        </div>
      </div>
      <FactsCard locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t(locale, 'section.industries')}</h2>
      <div class="grid grid--4" style="margin-top:1.5rem;">
        {industriesLocalized[locale].map((label) => (
          <div class="card" style="padding:0.9rem 1.1rem;">
            <strong>{label}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQ locale={locale} items={FAQ_GENERAL[locale]} />

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'section.why')}</h2>
      <div class="grid grid--3" style="margin-top:1.5rem;">
        <div class="card"><h3>{t(locale, 'why.quality')}</h3><p>{t(locale, 'why.quality_body')}</p></div>
        <div class="card"><h3>{t(locale, 'why.lead_time')}</h3><p>{t(locale, 'why.lead_time_body')}</p></div>
        <div class="card"><h3>{t(locale, 'why.support')}</h3><p>{t(locale, 'why.support_body')}</p></div>
      </div>
      <div style="margin-top:2rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
          {t(locale, 'cta.whatsapp')} · {SITE.wechat}
        </a>
      </div>
    </div>
  </section>
</Base>
