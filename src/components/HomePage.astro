    'cs996': 'Floor-type high-frequency C/S analyzer with expandable detection cells.',
    'onh-508': 'Inert-gas-fusion oxygen / nitrogen / hydrogen analyzer for steel, Ti, Zr, rare earth.',
    'f6000-pro': 'Handheld Si-PIN XRF analyzer, Ti to U, 8-hour battery, WiFi / Bluetooth.',
    'f7000-pro': 'Handheld Class-3B LIBS analyzer, sub-second analysis, 1.25 kg — measures light elements.',
  },
