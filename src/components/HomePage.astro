    'exquis-t4': 'Настольный ОЭС с замкнутой циркуляцией аргона, 50+ элементов, 33 кг — для QC у печи.',
    'innovate-t5': 'Полноспектральный CMOS-ОЭС с вакуумной оптикой, детекторы Hamamatsu, 10 матриц, 78 кг.',
    'noble-t7': 'Исследовательский CMOS-ОЭС, термостат ±0.1 °C, точность <10 ppm.',
    'surpass-f1': 'Мобильный ОЭС на тележке со встроенным аккумулятором и баллоном аргона.',
    'cs2020': 'Высокочастотный C/S-анализатор с 4 ячейками, авточисткой, 200+ циклов без ТО.',
    'cs995': 'Настольный высокочастотный ИК-анализатор C/S, 115 кг.',
    'cs996': 'Напольный высокочастотный C/S-анализатор с расширяемыми ячейками.',
    'onh-508': 'Анализатор кислорода/азота/водорода методом плавления в инертном газе — сталь, Ti, Zr, РЗМ.',
    'f6000-pro': 'Ручной РФА Si-PIN, диапазон Ti–U, 8 часов автономной работы, WiFi/BT.',
    'f7000-pro': 'Ручной LIBS-анализатор класс 3B, измерение <1 с, 1.25 кг — лёгкие элементы.',
  },
  es: {
    'exquis-t4': 'OES de mesa con ciclo cerrado, 50+ elementos, 33 kg — ideal para QC junto al horno.',
    'innovate-t5': 'OES de espectro completo CMOS con cámara al vacío y detectores Hamamatsu, 10 matrices, 78 kg.',
    'noble-t7': 'OES CMOS de grado investigación, cámara termostatizada (±0.1 °C), precisión <10 ppm.',
    'surpass-f1': 'OES móvil sobre carro con batería de litio y cilindro de argón integrados.',
    'cs2020': 'Analizador C/S de alta frecuencia con 4 celdas, autolimpieza, 200+ ciclos sin mantenimiento.',
