---
import Base from '../layouts/Base.astro';
import FactsCard from './FactsCard.astro';
import ProductImage from './ProductImage.astro';
import FAQ from './FAQ.astro';
import { SITE, PRODUCTS, INDUSTRIES, type Locale } from '../consts';
import { PRODUCT_LIST } from '../data/products/_registry';
import { t, localizedPath, whatsappUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { FAQ_GENERAL } from '../data/faq';

interface Props { locale: Locale }
const { locale } = Astro.props;

const title = t(locale, 'home.title');
const description = t(locale, 'hero.lede');
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_general'));

const productNames: Record<string, string> = {
  en: '', ru: '', es: '', ar: '',
};

// localized product short descriptions (full copy lives on product pages)
