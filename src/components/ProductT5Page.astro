---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { t5Specs, t5Overview, t5Applications, t5Faq } from '../data/innovate-t5';

interface Props { locale: Locale }
const { locale } = Astro.props;

const productName = 'Innovate T5 OES Spectrometer';
const path = '/products/innovate-t5/';
const title = `${productName} | JIEBO Instrument`;
const description = t5Overview[locale];
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_product', { product: productName }));

const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.products'), url: new URL(localizedPath(locale, '/products/'), Astro.site).toString() },
  { name: productName, url: canonical },
];

const productSchema = {
  name: productName,
  description: t5Overview[locale],
  sku: 'JIEBO-T5',
  category: 'Optical Emission Spectrometer',
};
---
<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  schemaType="product"
  product={productSchema}
  breadcrumbs={breadcrumbs}
  faq={t5Faq[locale]}
  whatsappContext="product"
  productName={productName}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <a href={localizedPath(locale, '/products/')}>{t(locale, 'breadcrumb.products')}</a> /
      <span>{productName}</span>
    </nav>
  </div>

  <section class="section" style="padding-block-start:1rem;">
    <div class="container">
      <p class="eyebrow">JIEBO · Floor-standing CCD OES</p>
      <h1>{productName}</h1>
      <p class="lede" style="margin-top:1rem;">{t5Overview[locale]}</p>
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
          {t(locale, 'cta.inquiry')}
        </a>
        <a class="button button--ghost" href={localizedPath(locale, '/learn/what-is-oes/')}>
          {t(locale, 'cta.learn_more')}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'product.spec_title')}</h2>
      <table class="spec" style="margin-top:1rem;">
        <tbody>
          {t5Specs.map((row) => (
            <tr>
              <th scope="row">{row.label[locale]}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t(locale, 'product.applications_title')}</h2>
      <ul style="margin-top:1rem; padding-inline-start:1.25rem;">
        {t5Applications[locale].map((line) => <li style="margin-bottom:0.5rem;">{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{t(locale, 'product.faq_title')}</h2>
      <div style="margin-top:1rem;">
        {t5Faq[locale].map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </div>
      <div style="margin-top:2rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">
          {t(locale, 'cta.inquiry')} · {SITE.wechat}
        </a>
      </div>
    </div>
  </section>
</Base>
