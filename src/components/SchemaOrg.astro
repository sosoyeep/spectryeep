---
import { SITE } from '../consts';

interface Props {
  type?: 'website' | 'product' | 'article';
  pageUrl: string;
  product?: {
    name: string;
    description: string;
    sku: string;
    category: string;
    brand?: string;
    /** Absolute URL of the product image. Falls back to the default OG asset when absent. */
    image?: string;
  };
  article?: {
    headline: string;
    description: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    /** Optional product references emitted as schema.org `mentions` — used by comparison pages so AI engines see the two products as entities, not free text. */
    mentions?: Array<{ name: string; sku?: string; url: string }>;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
  faq?: Array<{ q: string; a: string }>;
}

const { type = 'website', pageUrl, product, article, breadcrumbs, faq } = Astro.props;

const organization = {
  '@type': 'Organization',
  '@id': `https://${SITE.domain}/#organization`,
  name: SITE.brand,
  legalName: SITE.legalName,
  url: `https://${SITE.domain}/`,
  foundingDate: String(SITE.founded),
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.headOffice,
    addressLocality: SITE.city,
    addressRegion: SITE.addressRegion,
    addressCountry: SITE.countryCode,
  },
  location: {
    '@type': 'Place',
    name: `${SITE.brand} headquarters`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.headOffice,
      addressLocality: SITE.city,
      addressRegion: SITE.addressRegion,
      addressCountry: SITE.countryCode,
    },
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Worldwide' },
    { '@type': 'Country', name: 'Russia' },
    { '@type': 'Country', name: 'Saudi Arabia' },
    { '@type': 'Country', name: 'Brazil' },
    { '@type': 'Country', name: 'India' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  knowsAbout: [
    'Optical emission spectrometer',
    'Spark OES',
    'Carbon sulfur analyzer',
    'Oxygen nitrogen hydrogen analyzer',
    'Handheld XRF analyzer',
    'Handheld LIBS analyzer',
    'Foundry quality control',
    'Metal alloy analysis',
  ],
  brand: {
    '@type': 'Brand',
    name: SITE.brand,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'JIEBO analytical instruments',
    itemListElement: [
      { '@type': 'OfferCatalog', name: 'Optical emission spectrometers' },
      { '@type': 'OfferCatalog', name: 'Carbon sulfur analyzers' },
      { '@type': 'OfferCatalog', name: 'ONH analyzers' },
      { '@type': 'OfferCatalog', name: 'Handheld XRF and LIBS analyzers' },
    ],
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: `+${SITE.whatsapp}`,
      availableLanguage: ['English', 'Russian', 'Spanish', 'Arabic', 'Chinese'],
      areaServed: ['001'],
    },
  ],
  sameAs: [SITE.social.facebook, SITE.social.linkedin].filter(Boolean),
};

const graph: any[] = [organization];

if (type === 'website') {
  graph.push({
    '@type': 'WebSite',
    '@id': `https://${SITE.domain}/#website`,
    url: `https://${SITE.domain}/`,
    name: SITE.brand,
    publisher: { '@id': `https://${SITE.domain}/#organization` },
    inLanguage: ['en', 'ru', 'es', 'ar'],
  });
}

if (product) {
  graph.push({
    '@type': 'Product',
    name: product.name,
    description: product.description,
    sku: product.sku,
    category: product.category,
    brand: { '@type': 'Brand', name: product.brand ?? SITE.brand },
    manufacturer: { '@id': `https://${SITE.domain}/#organization` },
    url: pageUrl,
    image: product.image ?? `https://${SITE.domain}/og/default.png`,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'USD',
      priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'USD', valueAddedTaxIncluded: false },
      seller: { '@id': `https://${SITE.domain}/#organization` },
      url: pageUrl,
    },
  });
}

if (article) {
  const articleNode: any = {
    '@type': 'Article',
    headline: article.headline,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified ?? article.datePublished,
    author: { '@type': 'Organization', name: article.author ?? SITE.brand },
    publisher: { '@id': `https://${SITE.domain}/#organization` },
    mainEntityOfPage: pageUrl,
  };
  if (article.mentions && article.mentions.length > 0) {
    articleNode.mentions = article.mentions.map((m) => ({
      '@type': 'Product',
      name: m.name,
      ...(m.sku ? { sku: m.sku } : {}),
      url: m.url,
      brand: { '@id': `https://${SITE.domain}/#organization` },
    }));
  }
  graph.push(articleNode);
}

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.url,
    })),
  });
}

if (faq && faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
