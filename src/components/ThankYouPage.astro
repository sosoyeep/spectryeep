---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { localizedHome, whatsappUrl } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/thank-you/';
const waHref = whatsappUrl(SITE.whatsapp, 'Hi JIEBO, I just submitted an inquiry on spectryeep.com.');

const copy: Record<Locale, {
  title: string;
  description: string;
  h1: string;
  body: string;
  next: string;
  whatsapp: string;
  home: string;
}> = {
  en: {
    title: 'RFQ received | JIEBO Instrument',
    description: 'Thank you for contacting JIEBO Instrument. Our engineers will review your RFQ and reply with model recommendation, price and lead time.',
    h1: 'Your RFQ has been sent',
    body: 'Thank you. Our engineers will review your sample material, target elements and application notes, then reply with a recommended model, configuration, price and lead time.',
    next: 'For urgent projects, send a WhatsApp message with your company name so we can match it to the form submission.',
    whatsapp: 'Continue on WhatsApp',
    home: 'Back to home',
  },
  ru: {
    title: 'Запрос отправлен | JIEBO Instrument',
    description: 'Спасибо за обращение в JIEBO Instrument. Инженеры изучат запрос и ответят по модели, цене и сроку.',
    h1: 'Ваш запрос отправлен',
    body: 'Спасибо. Инженеры изучат материал образца, элементы и задачу, затем ответят с рекомендованной моделью, конфигурацией, ценой и сроком поставки.',
    next: 'Для срочных проектов напишите в WhatsApp название компании, чтобы мы сопоставили сообщение с формой.',
    whatsapp: 'Продолжить в WhatsApp',
    home: 'На главную',
  },
  es: {
    title: 'RFQ recibido | JIEBO Instrument',
    description: 'Gracias por contactar a JIEBO Instrument. Nuestros ingenieros revisarán su solicitud y responderán con modelo, precio y plazo.',
    h1: 'Su solicitud ha sido enviada',
    body: 'Gracias. Nuestros ingenieros revisarán el material de muestra, los elementos objetivo y la aplicación, y responderán con modelo recomendado, configuración, precio y plazo.',
    next: 'Para proyectos urgentes, envíe un WhatsApp con el nombre de su empresa para relacionarlo con el formulario.',
    whatsapp: 'Continuar por WhatsApp',
    home: 'Volver al inicio',
  },
  ar: {
    title: 'تم استلام الطلب | JIEBO Instrument',
    description: 'شكراً لتواصلك مع JIEBO Instrument. سيراجع المهندسون طلبك ويردّون بالموديل والسعر ومدة التسليم.',
    h1: 'تم إرسال طلبك',
    body: 'شكراً لك. سيراجع مهندسونا مادة العينة والعناصر المطلوبة وملاحظات التطبيق، ثم يرسلون الموديل والتكوين والسعر ومدة التسليم.',
    next: 'للمشاريع العاجلة، أرسل رسالة واتساب باسم شركتك حتى نربطها بطلب النموذج.',
    whatsapp: 'المتابعة عبر واتساب',
    home: 'العودة للرئيسية',
  },
};

const c = copy[locale];
---
<Base
  locale={locale}
  title={c.title}
  description={c.description}
  path={path}
  schemaType="website"
  whatsappContext="general"
  robots="noindex, follow"
>
  <section class="section">
    <div class="container" style="max-width:780px;">
      <p class="eyebrow">JIEBO Instrument · Quote desk</p>
      <h1>{c.h1}</h1>
      <p class="lede" style="margin-top:1rem;">{c.body}</p>
      <p>{c.next}</p>
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{c.whatsapp}</a>
        <a class="button button--ghost" href={localizedHome(locale)}>{c.home}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'generate_lead', form_name: 'jiebo-inquiry' });
    if (window.gtag) window.gtag('event', 'generate_lead', { form_name: 'jiebo-inquiry' });
  </script>
</Base>
