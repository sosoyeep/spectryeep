---
import Base from '../layouts/Base.astro';
import ProductImage from './ProductImage.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { PRODUCT_LIST } from '../data/products/_registry';
import { specLabels } from '../data/products/_specLabels';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/products/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_general'));

const copy: Record<Locale, {
  title: string; lede: string;
  groups: { oes: string; elemental: string; handheld: string };
  compareTitle: string; compareLede: string;
  cols: { product: string; category: string; detector: string; wavelength: string; matrices: string; weight: string };
  catLabel: { oes: string; elemental: string; handheld: string };
  faqTitle: string;
  faq: { q: string; a: string }[];
  whichToChoose: string;
  whichToChooseLede: string;
}> = {
  en: {
    title: 'Optical Emission Spectrometers and Elemental Analyzers',
    lede: 'JIEBO Instrument manufactures 11 analytical instrument models across three families: spark optical emission spectrometers (OES), combustion-based elemental analyzers, and handheld XRF / LIBS guns. All built in Wuxi, China and shipped to 40+ countries.',
    groups: { oes: 'Optical Emission Spectrometers (5 models)', elemental: 'Elemental Analyzers (4 models)', handheld: 'Handheld Analyzers (2 models)' },
    compareTitle: 'Compare all 11 models at a glance',
    compareLede: 'Headline specs for fast shortlisting. Click any model name for the full spec sheet and FAQ.',
    cols: { product: 'Model', category: 'Family', detector: 'Detector', wavelength: 'Wavelength / range', matrices: 'Base matrices / elements', weight: 'Weight' },
    catLabel: { oes: 'OES', elemental: 'Elemental', handheld: 'Handheld' },
    faqTitle: 'How to choose the right JIEBO model',
    whichToChoose: 'Not sure which model fits your application?',
    whichToChooseLede: 'Send us your sample matrix, target elements, and shift volume on WhatsApp — engineers reply within 4 working hours with a recommendation, quote and lead time.',
    faq: [
      { q: 'I need OES for a production foundry — which model?', a: 'Innovate T5 covers most production foundries (10 base matrices, vacuum chamber, 78 kg). Use Noble T7 if you need trace elements below 10 ppm or research-grade work. Use Exquis T4 if budget is tight and you only run one matrix. Use JB-750 for certification labs needing PMT-class precision.' },
      { q: 'I need on-site inspection without cutting samples.', a: 'Use F6000 Pro (XRF) for fast non-destructive grade ID without carbon. Use F7000 Pro (LIBS) when you need light elements (Mg, Si, Be) or want to avoid X-ray regulation. Use Surpass F1 (mobile OES) when carbon / sulfur quantification is required on site.' },
      { q: 'I need carbon and sulfur in steel or ore.', a: 'CS995 is the bench-type entry (115 kg, single C and S cell, 0.0005 % range). CS996 is floor-type with expandable cells (0.0001 % range). CS2020 is the high-end four-cell auto-cleaning unit for high-throughput labs.' },
      { q: 'I need oxygen, nitrogen and hydrogen analysis.', a: 'ONH-508 is the only model in this list that handles O / N / H simultaneously, using inert-gas fusion in an electrode pulse furnace. Common applications: titanium, zirconium, rare-earth alloys, deoxidized steel.' },
      { q: 'What lead times and warranties apply?', a: 'Stock OES and C/S configurations ship in 15 working days. Custom PMT (JB-750) and ONH-508 builds take 30 working days. All instruments carry a 12-month parts-and-labor warranty, extendable to 24 months.' },
    ],
  },
  ru: {
    title: 'Оптико-эмиссионные спектрометры и анализаторы элементного состава',
    lede: 'JIEBO Instrument производит 11 моделей аналитических приборов в трёх семействах: искровые ОЭС-спектрометры, анализаторы элементного состава методом сжигания, и ручные РФА/LIBS-приборы. Всё производится в Уси, Китай, и поставляется в 40+ стран.',
    groups: { oes: 'Оптико-эмиссионные спектрометры (5 моделей)', elemental: 'Анализаторы элементного состава (4 модели)', handheld: 'Ручные анализаторы (2 модели)' },
    compareTitle: 'Сравнение всех 11 моделей',
    compareLede: 'Ключевые характеристики для быстрого отбора. Нажмите на название модели — полные характеристики и FAQ.',
    cols: { product: 'Модель', category: 'Семейство', detector: 'Детектор', wavelength: 'Длины волн / диапазон', matrices: 'Матрицы / элементы', weight: 'Масса' },
    catLabel: { oes: 'ОЭС', elemental: 'Элементный', handheld: 'Ручной' },
    faqTitle: 'Как выбрать модель JIEBO',
    whichToChoose: 'Не уверены, какая модель подходит?',
    whichToChooseLede: 'Напишите матрицу образца, элементы и объём смены в WhatsApp — инженеры ответят за 4 рабочих часа с рекомендацией, ценой и сроком.',
    faq: [
      { q: 'Нужен ОЭС для литейного цеха — какая модель?', a: 'Innovate T5 покрывает большинство литейных производств (10 матриц, вакуумная камера, 78 кг). Noble T7 — если нужны следовые элементы ниже 10 ppm или исследовательская работа. Exquis T4 — при ограниченном бюджете и одной матрице. JB-750 — для сертификационных лабораторий с ФЭУ-точностью.' },
      { q: 'Нужен полевой контроль без вырезания образцов.', a: 'F6000 Pro (РФА) — для быстрой неразрушающей идентификации марки без углерода. F7000 Pro (LIBS) — для лёгких элементов (Mg, Si, Be) и при необходимости избежать радиационного регулирования. Surpass F1 (мобильный ОЭС) — когда требуется измерение углерода и серы на месте.' },
      { q: 'Нужен анализ углерода и серы в стали или руде.', a: 'CS995 — настольный начальный (115 кг, одна C и одна S ячейка, диапазон от 0,0005 %). CS996 — напольный с расширяемыми ячейками (от 0,0001 %). CS2020 — топовый с 4 ячейками и автоматической чисткой для лабораторий с большим потоком.' },
      { q: 'Нужен анализ кислорода, азота и водорода.', a: 'ONH-508 — единственная модель в списке, которая определяет O/N/H одновременно методом плавления в инертном газе. Применение: титан, цирконий, редкоземельные сплавы, раскисленная сталь.' },
      { q: 'Сроки и гарантия?', a: 'Стандартные ОЭС и C/S — 15 рабочих дней. JB-750 (ФЭУ) и ONH-508 на заказ — 30 рабочих дней. Гарантия 12 месяцев на запчасти и работу, продление до 24 месяцев.' },
    ],
  },
  es: {
    title: 'Espectrómetros de emisión óptica y analizadores elementales',
    lede: 'JIEBO Instrument fabrica 11 modelos de instrumentos analíticos en tres familias: espectrómetros OES por chispa, analizadores elementales por combustión, y analizadores portátiles XRF / LIBS. Fabricados en Wuxi, China, y exportados a más de 40 países.',
    groups: { oes: 'Espectrómetros de emisión óptica (5 modelos)', elemental: 'Analizadores elementales (4 modelos)', handheld: 'Analizadores portátiles (2 modelos)' },
    compareTitle: 'Compare los 11 modelos de un vistazo',
    compareLede: 'Especificaciones clave para preseleccionar rápido. Haga clic en cualquier nombre para la ficha completa y FAQ.',
    cols: { product: 'Modelo', category: 'Familia', detector: 'Detector', wavelength: 'Longitud de onda / rango', matrices: 'Matrices / elementos', weight: 'Peso' },
    catLabel: { oes: 'OES', elemental: 'Elemental', handheld: 'Portátil' },
    faqTitle: 'Cómo elegir el modelo JIEBO adecuado',
    whichToChoose: '¿No sabe qué modelo le sirve?',
    whichToChooseLede: 'Envíenos matriz, elementos objetivo y volumen por turno por WhatsApp — ingenieros responden en 4 horas hábiles con recomendación, cotización y plazo.',
    faq: [
      { q: 'Necesito OES para una fundición de producción — ¿qué modelo?', a: 'Innovate T5 cubre la mayoría de fundiciones (10 matrices, cámara al vacío, 78 kg). Use Noble T7 si necesita trazas bajo 10 ppm o trabajo de investigación. Use Exquis T4 si el presupuesto es ajustado y tiene una sola matriz. Use JB-750 para laboratorios de certificación que exijan precisión PMT.' },
      { q: 'Necesito inspección en sitio sin cortar muestras.', a: 'Use F6000 Pro (XRF) para ID rápida no destructiva sin carbono. Use F7000 Pro (LIBS) cuando necesite elementos ligeros (Mg, Si, Be) o quiera evitar regulación de rayos X. Use Surpass F1 (OES móvil) cuando se requiera cuantificar carbono / azufre en sitio.' },
      { q: 'Necesito carbono y azufre en acero o mineral.', a: 'CS995 es el de mesa de entrada (115 kg, una celda C y una S, rango desde 0,0005 %). CS996 es de pie con celdas ampliables (desde 0,0001 %). CS2020 es la unidad superior de cuatro celdas con autolimpieza para laboratorios de alto volumen.' },
      { q: 'Necesito analizar oxígeno, nitrógeno e hidrógeno.', a: 'ONH-508 es el único modelo aquí que maneja O / N / H simultáneamente, por fusión en gas inerte en horno de pulsos por electrodo. Aplicaciones: titanio, circonio, aleaciones de tierras raras, acero desoxidado.' },
      { q: '¿Plazos y garantías?', a: 'Configuraciones OES y C/S en stock se envían en 15 días hábiles. JB-750 (PMT) y ONH-508 a pedido: 30 días hábiles. Garantía de 12 meses en piezas y mano de obra, ampliable a 24 meses.' },
    ],
  },
  ar: {
    title: 'أجهزة طيف الانبعاث الضوئي ومحلّلات العناصر',
    lede: 'تصنع JIEBO Instrument 11 موديلاً من الأجهزة التحليلية في ثلاث عائلات: مطيافيات OES بالشرارة، ومحلّلات عناصر بالاحتراق، ومحلّلات محمولة XRF و LIBS. كلّها صُنعت في ووشي، الصين، وصُدِّرت إلى أكثر من 40 دولة.',
    groups: { oes: 'مطيافيات الانبعاث الضوئي (5 موديلات)', elemental: 'محلّلات العناصر (4 موديلات)', handheld: 'محلّلات محمولة (موديلان)' },
    compareTitle: 'مقارنة الـ 11 موديلاً في لمحة',
    compareLede: 'مواصفات رئيسية للترشيح السريع. انقر على أيّ اسم موديل لتظهر صحيفة المواصفات الكاملة والأسئلة الشائعة.',
    cols: { product: 'الموديل', category: 'العائلة', detector: 'الكاشف', wavelength: 'الطول الموجي / النطاق', matrices: 'المصفوفات / العناصر', weight: 'الوزن' },
    catLabel: { oes: 'OES', elemental: 'تحليل عناصر', handheld: 'محمول' },
    faqTitle: 'كيف تختار موديل JIEBO المناسب',
    whichToChoose: 'لست متأكّداً أيّ موديل يناسب تطبيقك؟',
    whichToChooseLede: 'أرسل لنا مصفوفة العيّنة والعناصر المستهدفة وحجم الإنتاج عبر واتساب — يردّ المهندسون خلال 4 ساعات عمل بتوصية وعرض سعر ومدّة تسليم.',
    faq: [
      { q: 'أحتاج OES لمسبك إنتاجي — أيّ موديل؟', a: 'يغطّي Innovate T5 معظم المسابك الإنتاجية (10 مصفوفات وغرفة مفرّغة و78 كغ). استخدم Noble T7 إذا احتجت عناصر نزرة دون 10 ppm أو عملاً بحثياً. استخدم Exquis T4 لميزانية محدودة ومصفوفة واحدة. استخدم JB-750 لمختبرات الاعتماد التي تتطلّب دقّة من فئة PMT.' },
      { q: 'أحتاج فحصاً في الموقع دون قطع العيّنات.', a: 'استخدم F6000 Pro (XRF) لتعريف الدرجة بسرعة وغير متلف دون الكربون. استخدم F7000 Pro (LIBS) للعناصر الخفيفة (Mg و Si و Be) أو لتجنّب تنظيم الأشعة السينية. استخدم Surpass F1 (OES متنقّل) عند الحاجة لقياس الكربون والكبريت في الموقع.' },
      { q: 'أحتاج قياس الكربون والكبريت في الصلب أو الخام.', a: 'CS995 هو الخيار المكتبي الأساسي (115 كغ، خليّة C وأخرى S، نطاق من 0.0005 %). CS996 أرضي بخلايا قابلة للتوسعة (من 0.0001 %). CS2020 هو الراقي بأربع خلايا وتنظيف آلي للمختبرات عالية الإنتاجية.' },
      { q: 'أحتاج تحليل الأكسجين والنيتروجين والهيدروجين.', a: 'ONH-508 هو الموديل الوحيد هنا الذي يعالج O و N و H في وقت واحد عبر الانصهار في غاز خامل داخل فرن نبضي بالأقطاب. تطبيقاته الشائعة: التيتانيوم والزركونيوم وسبائك الأتربة النادرة والصلب منزوع الأكسجين.' },
      { q: 'ما المدد الزمنية والضمانات؟', a: 'تكوينات OES و C/S المتوفّرة في المخزون تُشحَن خلال 15 يوم عمل. JB-750 (PMT) و ONH-508 المصنوعان حسب الطلب: 30 يوم عمل. ضمان 12 شهراً على القطع واليد العاملة قابل للتمديد إلى 24 شهراً.' },
    ],
  },
};

// Per-product compare-table row (specs sourced from the brochure-verified product records).
const compareRows: Array<{ slug: string; detector: string; wavelength: string; matricesOrElements: string; weight: string }> = [
  { slug: 'exquis-t4', detector: 'CMOS, sealed argon', wavelength: '160–580 nm', matricesOrElements: 'Fe / Al / Cu / Zn · 50+ elements', weight: '33 kg' },
  { slug: 'innovate-t5', detector: 'Hamamatsu CMOS, vacuum', wavelength: '140–680 nm', matricesOrElements: '10 base matrices', weight: '78 kg' },
  { slug: 'noble-t7', detector: 'Research-grade CMOS, ±0.1 °C', wavelength: '120–800 nm', matricesOrElements: '10 base matrices · <10 ppm', weight: '160 kg' },
  { slug: 'jb-750', detector: 'PMT array, vacuum', wavelength: '120–800 nm', matricesOrElements: '10 base matrices · 750 mm focal', weight: '256 kg' },
  { slug: 'surpass-f1', detector: 'Portable spark probe', wavelength: '160–425 nm', matricesOrElements: 'UV: C / P / S / B / As / Sn / Se / N', weight: '45 kg' },
  { slug: 'cs2020', detector: '4 IR cells, auto cleaning', wavelength: 'IR — C/S', matricesOrElements: 'C/S: 0.00001 – 99.99 %', weight: '110 kg' },
  { slug: 'cs995', detector: '1 C + 1 S IR cell', wavelength: 'IR — C/S', matricesOrElements: 'C: 0.0005 – 6 %; S: 0.0005 – 0.35 %', weight: '115 kg' },
  { slug: 'cs996', detector: 'Expandable IR cells', wavelength: 'IR — C/S', matricesOrElements: 'C: 0.0001 – 10 %; S: 0.0001 – 2 %', weight: '215 kg' },
  { slug: 'onh-508', detector: 'NDIR + TCD', wavelength: 'IR + TCD — O/N/H', matricesOrElements: 'O 0.5 ppm – 20 %; N 0.5 ppm – 50 %; H 0.2 ppm – 0.1 %', weight: '160 kg' },
  { slug: 'f6000-pro', detector: 'Si-PIN X-ray, 50 kV', wavelength: 'X-ray fluorescence', matricesOrElements: 'Ti to U (alloy ID)', weight: 'Handheld' },
  { slug: 'f7000-pro', detector: 'Class 3B laser plasma', wavelength: 'LIBS broadband', matricesOrElements: 'Be, Mg, Al, Si, Ti, Cr, Mn, Fe, Ni, Cu …', weight: '1.25 kg' },
];

function nameOf(slug: string): string {
  return PRODUCT_LIST.find((p) => p.slug === slug)?.name ?? slug;
}
function categoryOf(slug: string): 'oes' | 'elemental' | 'handheld' {
  return (PRODUCT_LIST.find((p) => p.slug === slug)?.category ?? 'oes') as any;
}

const c = copy[locale];
const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.products'), url: canonical },
];

const byCategory: Record<'oes' | 'elemental' | 'handheld', typeof PRODUCT_LIST> = {
  oes: PRODUCT_LIST.filter((p) => p.category === 'oes'),
  elemental: PRODUCT_LIST.filter((p) => p.category === 'elemental'),
  handheld: PRODUCT_LIST.filter((p) => p.category === 'handheld'),
};
---
<Base
  locale={locale}
  title={`${c.title} | JIEBO Instrument`}
  description={c.lede}
  path={path}
  schemaType="website"
  breadcrumbs={breadcrumbs}
  faq={c.faq}
  whatsappContext="general"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <span>{t(locale, 'breadcrumb.products')}</span>
    </nav>
  </div>

  <section class="section" style="padding-block-start:1rem;">
    <div class="container">
      <p class="eyebrow">JIEBO Instrument · 11 production models</p>
      <h1>{c.title}</h1>
      <p class="lede" style="margin-top:1rem;">{c.lede}</p>
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')}</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{c.compareTitle}</h2>
      <p style="color:var(--muted); margin-top:0.25rem;">{c.compareLede}</p>
      <div style="overflow-x:auto; margin-top:1rem;">
        <table class="spec" style="min-width:760px;">
          <thead>
            <tr>
              <th>{c.cols.product}</th>
              <th>{c.cols.category}</th>
              <th>{c.cols.detector}</th>
              <th>{c.cols.wavelength}</th>
              <th>{c.cols.matrices}</th>
              <th>{c.cols.weight}</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr class={`compare-row compare-row--${categoryOf(row.slug)}`}>
                <td><a href={localizedPath(locale, `/products/${row.slug}/`)}><strong>{nameOf(row.slug)}</strong></a></td>
                <td>{c.catLabel[categoryOf(row.slug)]}</td>
                <td>{row.detector}</td>
                <td>{row.wavelength}</td>
                <td>{row.matricesOrElements}</td>
                <td>{row.weight}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <input type="radio" name="cat-filter" id="filter-all" class="cat-filter-input" checked />
  <input type="radio" name="cat-filter" id="filter-oes" class="cat-filter-input" />
  <input type="radio" name="cat-filter" id="filter-elemental" class="cat-filter-input" />
  <input type="radio" name="cat-filter" id="filter-handheld" class="cat-filter-input" />

  <div class="container">
    <div class="cat-tabs" role="tablist" aria-label="Product category filter">
      <label for="filter-all" class="cat-tab" data-filter="all">{locale === 'en' ? 'All 11' : locale === 'ru' ? 'Все 11' : locale === 'es' ? 'Todos los 11' : 'الكل (11)'}</label>
      <label for="filter-oes" class="cat-tab" data-filter="oes">{c.catLabel.oes}</label>
      <label for="filter-elemental" class="cat-tab" data-filter="elemental">{c.catLabel.elemental}</label>
      <label for="filter-handheld" class="cat-tab" data-filter="handheld">{c.catLabel.handheld}</label>
    </div>
  </div>

  {(['oes', 'elemental', 'handheld'] as const).map((cat) => (
    <section class={`section cat-section cat-section--${cat}`}>
      <div class="container">
        <h2>{c.groups[cat]}</h2>
        <div class="grid grid--3" style="margin-top:1.5rem;">
          {byCategory[cat].map((p) => (
            <a class="card product-card" href={localizedPath(locale, `/products/${p.slug}/`)}>
              <ProductImage product={p} locale={locale} variant="thumb" />
              <h3 style="margin-top:0.75rem; margin-bottom:0.4rem; font-size:1.05rem;">{p.name[locale]}</h3>
              <p style="margin:0; color:var(--muted); font-size:0.9rem;">{p.overview[locale]?.split('. ').slice(0, 2).join('. ')}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section--alt">
    <div class="container">
      <h2>{c.faqTitle}</h2>
      <div style="margin-top:1rem;">
        {c.faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background:var(--card);">
        <h3 style="margin-bottom:0.5rem;">{c.whichToChoose}</h3>
        <p style="margin-bottom:1rem; color:var(--muted);">{c.whichToChooseLede}</p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')} · {SITE.wechat}</a>
      </div>
    </div>
  </section>
</Base>
