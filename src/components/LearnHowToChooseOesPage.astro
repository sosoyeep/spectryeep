---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { title, description, datePublished, sections, faq } from '../data/learn-how-to-choose-oes';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/learn/how-to-choose-oes-spectrometer/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_learn'));
const pageTitle = `${title[locale]} | JIEBO Instrument`;

const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.learn'), url: new URL(localizedPath(locale, '/learn/'), Astro.site).toString() },
  { name: title[locale], url: canonical },
];

const articleSchema = {
  headline: title[locale],
  description: description[locale],
  datePublished,
};
---
<Base
  locale={locale}
  title={pageTitle}
  description={description[locale]}
  path={path}
  schemaType="article"
  article={articleSchema}
  breadcrumbs={breadcrumbs}
  faq={faq[locale]}
  whatsappContext="learn"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <a href={localizedPath(locale, '/learn/')}>{t(locale, 'breadcrumb.learn')}</a> /
      <span>{title[locale]}</span>
    </nav>
  </div>

  <article class="section" style="padding-block-start:1rem;">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">{t(locale, 'breadcrumb.learn')}</p>
      <h1>{title[locale]}</h1>
      <p class="lede" style="margin-top:1rem;">{description[locale]}</p>

      {sections[locale].map((s) => (
        <section style="margin-top:2rem;">
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p set:html={p.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')} />)}
        </section>
      ))}

      <section style="margin-top:2.5rem;">
        <h2>{t(locale, 'product.faq_title')}</h2>
        {faq[locale].map((f) => (
          <details class="faq" style="margin-top:0.5rem;">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </section>

      <aside class="card" style="margin-top:2.5rem; background:var(--card);">
        <h3 style="margin-bottom:0.5rem;">{t(locale, 'cta.inquiry')}</h3>
        <p style="margin-bottom:1rem; color:var(--muted);">
          {locale === 'en' && 'Still unsure which OES model fits your application? Send your sample matrices, target elements and shift volume on WhatsApp — engineers reply within 4 working hours with a model recommendation, quote and lead time.'}
          {locale === 'ru' && 'Не уверены, какая модель ОЭС подходит? Напишите ваши матрицы образцов, нужные элементы и объём смены в WhatsApp — инженеры ответят за 4 рабочих часа с рекомендацией модели, ценой и сроком.'}
          {locale === 'es' && '¿Aún no sabe qué modelo OES le sirve? Envíenos sus matrices de muestra, elementos objetivo y volumen por turno por WhatsApp — los ingenieros responden en 4 horas hábiles con recomendación, cotización y plazo.'}
          {locale === 'ar' && 'لم تحدّد بعد أيّ موديل OES يناسب تطبيقك؟ أرسل لنا مصفوفات العيّنة والعناصر المستهدفة وحجم الوردية عبر واتساب — يردّ المهندسون خلال 4 ساعات عمل بتوصية موديل وعرض سعر ومدّة تسليم.'}
        </p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')}</a>
      </aside>
    </div>
  </article>
</Base>
