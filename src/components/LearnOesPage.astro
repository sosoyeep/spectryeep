---
import Base from '../layouts/Base.astro';
import { SITE, type Locale } from '../consts';
import { t, localizedPath, whatsappUrl, localizedHome } from '../i18n/utils';
import { title, description, datePublished, sections, faq } from '../data/learn-what-is-oes';

interface Props { locale: Locale }
const { locale } = Astro.props;

const path = '/learn/what-is-oes/';
const canonical = new URL(localizedPath(locale, path), Astro.site).toString();
const waHref = whatsappUrl(SITE.whatsapp, t(locale, 'whatsapp.prefill_learn'));
const pageTitle = `${title[locale]} | JIEBO Instrument`;

const breadcrumbs = [
  { name: t(locale, 'breadcrumb.home'), url: new URL(localizedHome(locale), Astro.site).toString() },
  { name: t(locale, 'breadcrumb.learn'), url: new URL(localizedPath(locale, '/learn/'), Astro.site).toString() },
  { name: title[locale], url: canonical },
];

const articleSchema = {
  headline: title[locale],
  description: description[locale],
  datePublished,
};
---
<Base
  locale={locale}
  title={pageTitle}
  description={description[locale]}
  path={path}
  schemaType="article"
  article={articleSchema}
  breadcrumbs={breadcrumbs}
  faq={faq[locale]}
  whatsappContext="learn"
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localizedHome(locale)}>{t(locale, 'breadcrumb.home')}</a> /
      <a href={localizedPath(locale, '/learn/')}>{t(locale, 'breadcrumb.learn')}</a> /
      <span>{title[locale]}</span>
    </nav>
  </div>

  <article class="section" style="padding-block-start:1rem;">
    <div class="container" style="max-width:780px;">
      <p class="eyebrow">{t(locale, 'breadcrumb.learn')}</p>
      <h1>{title[locale]}</h1>
      <p class="lede" style="margin-top:1rem;">{description[locale]}</p>

      {sections[locale].map((s) => (
        <section style="margin-top:2rem;">
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
        </section>
      ))}

      <section style="margin-top:2.5rem;">
        <h2>{t(locale, 'product.faq_title')}</h2>
        {faq[locale].map((f) => (
          <details class="faq" style="margin-top:0.5rem;">
            <summary>{f.q}</summary>
            <p style="margin-top:0.6rem;">{f.a}</p>
          </details>
        ))}
      </section>

      <aside class="card" style="margin-top:2.5rem; background:var(--card);">
        <h3 style="margin-bottom:0.5rem;">{t(locale, 'cta.inquiry')}</h3>
        <p style="margin-bottom:1rem; color:var(--muted);">
          {locale === 'en' && 'Still unsure which spectrometer fits your application? Send us your sample matrix and target elements on WhatsApp — we usually reply within 4 working hours.'}
          {locale === 'ru' && 'Не определились с моделью? Напишите матрицу образца и определяемые элементы в WhatsApp — обычно отвечаем в течение 4 рабочих часов.'}
          {locale === 'es' && '¿Todavía no sabe qué espectrómetro le conviene? Envíenos su matriz y elementos objetivo por WhatsApp — solemos responder en menos de 4 horas hábiles.'}
          {locale === 'ar' && 'لم تحدّد بعد أيّ جهاز يناسب تطبيقك؟ أرسل لنا مصفوفة العيّنة والعناصر المستهدفة عبر واتساب — نردّ غالباً خلال 4 ساعات عمل.'}
        </p>
        <a class="button button--primary" href={waHref} target="_blank" rel="noopener">{t(locale, 'cta.whatsapp')}</a>
      </aside>
    </div>
  </article>
</Base>
