# Public form endpoint used by Astro pages.
# Default in code: /api/inquiry
PUBLIC_INQUIRY_FORM_ACTION=/api/inquiry

# Optional Cloudflare Turnstile widget. Create keys at:
# https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional forwarding targets used by netlify/functions/inquiry.js.
# Formspree sends email notifications and can also connect to integrations.
FORMSPREE_ENDPOINT=

# Use a CRM webhook for HubSpot, Zoho, Pipedrive, Make, Zapier, n8n, or your own API.
# For Google Sheets CRM, use the Apps Script Web App URL with ?token=...
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Optional email/webhook relay if you use Resend, Brevo, Make, Zapier, or a custom mail service.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Safety fallback. If CRM/email webhooks are missing or fail, the function redirects
# the browser POST to this endpoint so inquiries still reach email.
FALLBACK_FORM_ACTION=https://formsubmit.co/sophia@wxjiebo.cc

# Anti-spam tuning.
MIN_SUBMIT_SECONDS=4
INQUIRY_RATE_LIMIT_MAX=5

# --- Auto-reply system (see AUTO_REPLY_SETUP.md) ---

# Customer-facing reply email (Resend: https://resend.com). Without this, the
# website form still works but no confirmation email is sent to the buyer.
RESEND_API_KEY=
AUTOREPLY_FROM=JIEBO Instrument <sales@spectryeep.com>
# Internal inbox that receives the AI draft for approval. Defaults to SITE email.
NOTIFY_EMAIL=sophia@wxjiebo.cc

# Claude API for the AI reply draft (template + AI hybrid). Optional — without
# it customers still get the instant template reply.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# WhatsApp Business Cloud API (Meta). Needed for /api/webhooks/whatsapp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Shared secret for the inbound email webhook /api/webhooks/email (optional).
INBOUND_EMAIL_TOKEN=
