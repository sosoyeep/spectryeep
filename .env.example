# Public form endpoint used by Astro pages.
# Default in code: /api/inquiry
PUBLIC_INQUIRY_FORM_ACTION=/api/inquiry

# Optional Cloudflare Turnstile widget. Create keys at:
# https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
# Runtime alias accepted by /api/inquiry-config.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional forwarding targets used by netlify/functions/inquiry.js.
# Formspree sends email notifications and can also connect to integrations.
FORMSPREE_ENDPOINT=

# Use a CRM webhook for HubSpot, Zoho, Pipedrive, Make, Zapier, n8n, or your own API.
# For Google Sheets CRM, use the Apps Script Web App URL with ?token=...
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Optional email/webhook relay if you use Resend, Brevo, Make, Zapier, or a custom mail service.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Safety fallback. If CRM/email webhooks are missing or fail, the function redirects
# the browser POST to this endpoint so inquiries still reach email.
FALLBACK_FORM_ACTION=https://formsubmit.co/sophia@wxjiebo.cc

# Anti-spam tuning.
MIN_SUBMIT_SECONDS=4
INQUIRY_RATE_LIMIT_MAX=5
